# Required: Discord bot token used by the E2E runner.
DISCORD_TOKEN=

# Required: isolated test guild only. Never point this at production.
DISCORD_GUILD_ID=

# Destructive suites require this AND the --destructive CLI flag.
E2E_ALLOW_DESTRUCTIVE=false

E2E_TIMEOUT=20
E2E_POLL_INTERVAL=0.75
E2E_MAX_RETRIES=5

# Conservative mutation pacing. These are safety controls, not anti-spam bypass settings.
E2E_MIN_MUTATION_DELAY=2.0
E2E_MAX_MUTATION_JITTER=2.5
E2E_MAX_CONSECUTIVE_MUTATIONS=5
E2E_BATCH_COOLDOWN=5.0
E2E_MAX_RATE_LIMIT_EVENTS=3

# Actor IDs only; never put credentials here.
E2E_OWNER_USER_ID=
E2E_ADMIN_USER_ID=
E2E_TEACHER_USER_ID=
E2E_STUDENT_USER_ID=
E2E_NORMAL_USER_ID=
