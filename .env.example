# Required: Discord bot token used by the E2E runner for documented API access.
DISCORD_TOKEN=

# Required: the ONLY guild the runner may address. Use an isolated test guild.
DISCORD_GUILD_ID=

# Optional: ID of the School Discord Manager bot. This is used to verify membership,
# not to claim that a REST observer can see the bot's gateway connection state.
TARGET_BOT_ID=

# Destructive suites require this AND the --destructive CLI flag.
E2E_ALLOW_DESTRUCTIVE=false

E2E_TIMEOUT=20
E2E_POLL_INTERVAL=0.75
E2E_MAX_RETRIES=5
E2E_REPORT_DIR=reports
E2E_FIXTURE_MANIFEST=.e2e/fixtures.json

# Conservative mutation pacing. These are safety controls, not anti-spam bypass settings.
E2E_MIN_MUTATION_DELAY=2.0
E2E_MAX_MUTATION_JITTER=2.5
E2E_MAX_CONSECUTIVE_MUTATIONS=5
E2E_BATCH_COOLDOWN=5.0
E2E_MAX_RATE_LIMIT_EVENTS=3

# Actor IDs only; never put credentials here.
E2E_OWNER_USER_ID=
E2E_ADMIN_USER_ID=
E2E_TEACHER_USER_ID=
E2E_STUDENT_USER_ID=
E2E_NORMAL_USER_ID=
